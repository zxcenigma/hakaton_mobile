# TLS перед API «Монетки».
#
# Почему вообще: сейчас приложение ходит на http://91.210.106.86:6767, и JWT
# уходит открытым текстом — его видит любой узел по дороге, включая публичный
# Wi-Fi. Для приложения, где ТЗ §3.5 запрещает утечку детских данных, это не
# «доделаем потом».
#
# Второе, менее очевидное: с Android 9 (API 28) открытый HTTP запрещён по
# умолчанию. В манифесте приложения нет ни usesCleartextTraffic, ни
# networkSecurityConfig — значит на любом современном телефоне запросы к API
# уже не проходят. TLS здесь не только защита, но и условие работоспособности.
#
# Почему имя 91-210-106-86.sslip.io, а не голый IP: Let's Encrypt выдаёт
# обычные сертификаты на доменные имена, а не на IP-адреса. sslip.io — публичный
# DNS, который резолвит такое имя обратно в тот же адрес; проверено, резолвится.
# Это рабочий способ получить настоящий сертификат, пока нет своего домена.
#
# Когда появится свой домен — заменить имя ниже на него, и больше ничего.
# Caddy сам получит и будет продлевать сертификат; cron и certbot не нужны.

{
	# Адрес для уведомлений Let's Encrypt об истечении сертификата.
	#
	# ЗАПОЛНИТЬ перед первым запуском. Это единственное обязательное поле во
	# всём файле: на эту почту придёт предупреждение, если продление однажды
	# сломается, и без неё о просроченном сертификате узнают от пользователей.
	#
	# Адрес уходит в Let's Encrypt как контакт ACME-аккаунта, поэтому вписывать
	# его должен тот, чей он есть. Подойдёт общий ящик команды — так письмо
	# увидит не один человек.
	email ЗАПОЛНИТЬ@example.com
}

91-210-106-86.sslip.io {
	# API слушает внутри сети Docker, наружу напрямую больше не торчит.
	reverse_proxy hakaton_mobile_api:6767

	encode gzip

	header {
		# Полгода. Без preload намеренно: preload подаётся на весь домен
		# sslip.io, который нам не принадлежит, и отозвать его нельзя.
		Strict-Transport-Security "max-age=15768000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Caddy по умолчанию представляется в заголовке; версия прокси наружу
		# никому не нужна.
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Тело запросов не пишем: там логины и данные детей.
		format json
	}
}

# Голый IP по HTTP: отвечаем редиректом, а не молчанием.
#
# Старая сборка приложения продолжит стучаться на http://91.210.106.86 — и
# тихий отказ будет выглядеть как «сервер лёг». Явный редирект виден в логах
# и в отладчике, по нему сразу понятно, что адрес надо обновить.
http://91.210.106.86 {
	redir https://91-210-106-86.sslip.io{uri} permanent
}
