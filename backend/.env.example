# Uvicorn server settings (bind address, independent of API_HOST/API_PORT)
SERVER_HOST=0.0.0.0
SERVER_PORT=6767
SERVER_WORKERS=1
SERVER_LOG_LEVEL=info
SERVER_PROXY_HEADERS=true
# Trust all proxy sources, as in the original Docker entrypoint.
# Set trusted proxy IPs/networks when the server is directly reachable.
SERVER_FORWARDED_ALLOW_IPS=*

# API Settings
API_NAME=hakaton_mobile_api
API_VERSION=1.0.1
API_PROTOCOL=http

# JWT Settings (JWS)
JWT_ALGORITHM=RS256
JWT_AVAILABLE_DAYS=90
JWT_ACCESS_MINUTES=15

# DB Settings
PG_USER=user
PG_PASSWORD=password
PG_DB=hakaton_mobile_db
# PG_HOST=cc_db
PG_HOST=127.0.0.1
PG_PORT=5432

# DB-Connection Settings
POOL_MAX_OVERFLOW=0
POOL_SIZE=10
POOL_TIMEOUT=10
POOL_RECYCLE=1800

# REDIS-0
REDIS_HOST=127.0.0.1
# redis_host=cc_redis
REDIS_PORT=6379
REDIS_DB=0