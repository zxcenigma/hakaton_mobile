# Copy to `.env` and adjust:
#
#     cp ml_service/.env.template ml_service/.env
#
# `.env` is git-ignored (ТЗ §3.4 — «в репозитории отсутствуют пароли, токены,
# закрытые ключи подписи»). Every value below is a local development default:
# none of them is a real credential, and none of them is safe outside a laptop.
#
# Every variable carries the `MONETKA_` prefix. The backend reads flat names
# (`PG_HOST`, `SERVER_PORT`) from its own `.env`; the prefix is what keeps a
# shared orchestrator from repointing this service's warehouse by accident.
#
# Path-valued settings (`MONETKA_DATA_DIR`, `MONETKA_ARTIFACTS_DIR`,
# `MONETKA_WAREHOUSE_PATH`, `MONETKA_API_MODEL_DIR`) default to directories
# inside `ml_service/` and are deliberately absent here — set one only to move
# storage somewhere else, such as a mounted volume.

# ----------------------------------------------------------------- general ---
MONETKA_RUN_MODE=local          # local | compose | ci
MONETKA_ENV=dev
MONETKA_LOG_LEVEL=INFO
MONETKA_RANDOM_SEED=20260305    # identical seed ⇒ identical synthetic dataset

# --------------------------------------------------------------- generator ---
# The synthetic cohort. Until the app emits real telemetry this is the only
# source of data, and the seed is what makes a run reproducible.
MONETKA_SIM_PLAYERS=2000
MONETKA_SIM_PERIODS=12
MONETKA_SIM_START_DATE=2026-01-12

# ------------------------------------------------------- object storage ------
# SeaweedFS in compose; unused in `local` mode, which writes to the filesystem.
MONETKA_S3_ENDPOINT=http://localhost:9000
MONETKA_S3_ACCESS_KEY=monetkalocal
MONETKA_S3_SECRET_KEY=monetkalocal
MONETKA_S3_BUCKET_BRONZE=monetka-bronze
MONETKA_S3_BUCKET_SILVER=monetka-silver
MONETKA_S3_BUCKET_GOLD=monetka-gold
MONETKA_S3_REGION=us-east-1

# ------------------------------------------------------------- streaming -----
MONETKA_KAFKA_BOOTSTRAP=localhost:19092
MONETKA_KAFKA_TOPIC_EVENTS=monetka.game.events.v1
MONETKA_KAFKA_TOPIC_DLQ=monetka.game.events.dlq.v1
MONETKA_KAFKA_CONSUMER_GROUP=monetka-bronze-ingestor
MONETKA_SCHEMA_REGISTRY_URL=http://localhost:18081

# ------------------------------------------------------------- lakehouse -----
MONETKA_ICEBERG_CATALOG_URI=http://localhost:8181
MONETKA_ICEBERG_WAREHOUSE=s3://monetka-bronze/warehouse
MONETKA_TRINO_HOST=localhost
MONETKA_TRINO_PORT=8080

# ----------------------------------------------------------------- mlops -----
MONETKA_MLFLOW_TRACKING_URI=http://localhost:5000
MONETKA_MLFLOW_EXPERIMENT=monetka
MONETKA_MODEL_REGISTRY_STAGE=Production

# --------------------------------------------------------------- serving -----
MONETKA_API_HOST=0.0.0.0
MONETKA_API_PORT=8000

# ------------------------------------------------------- quality gates -------
# A model below the accuracy floor is not promoted; the pipeline keeps serving
# the rules instead. See docs/ml-cards/ for what each threshold protects.
MONETKA_MIN_MODEL_ACCURACY=0.80
MONETKA_DRIFT_PSI_THRESHOLD=0.2
MONETKA_DQ_MAX_LATE_EVENT_HOURS=72
MONETKA_DQ_MAX_NULL_FRACTION=0.0

# -------------------------------------------------------------- metadata -----
# Postgres backs MLflow and Airflow in the compose stack. Not used in `local`.
POSTGRES_USER=monetka
POSTGRES_PASSWORD=monetka

# ------------------------------------------------------------ admin UIs ------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
