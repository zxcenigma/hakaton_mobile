{
  "$id": "ru.mos.monetka.events.v1.savings_withdrawn",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ТЗ §2.5.7 — withdrawal requires a separate explicit confirmation, and the\nconsequence is shown before it happens.",
  "properties": {
    "amount": {
      "description": "In-game currency, integer units",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Amount",
      "type": "integer"
    },
    "balance_after": {
      "description": "In-game currency, integer units",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Balance After",
      "type": "integer"
    },
    "confirmed": {
      "const": true,
      "title": "Confirmed",
      "type": "boolean"
    },
    "eta_periods_after": {
      "anyOf": [
        {
          "maximum": 999,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eta Periods After"
    },
    "eta_periods_before": {
      "anyOf": [
        {
          "maximum": 999,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eta Periods Before"
    },
    "goal_id": {
      "pattern": "^[a-z0-9_]{3,40}$",
      "title": "Goal Id",
      "type": "string"
    },
    "savings_after": {
      "description": "In-game currency, integer units",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Savings After",
      "type": "integer"
    }
  },
  "required": [
    "goal_id",
    "amount",
    "savings_after",
    "balance_after",
    "confirmed"
  ],
  "title": "SavingsWithdrawnPayload",
  "type": "object",
  "x-monetka-event": "savings_withdrawn",
  "x-monetka-schema-version": 1
}
