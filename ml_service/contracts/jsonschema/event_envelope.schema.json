{
  "$defs": {
    "EventName": {
      "enum": [
        "app_opened",
        "profile_created",
        "pet_customised",
        "income_granted",
        "budget_plan_submitted",
        "purchase_made",
        "purchase_rejected",
        "savings_deposited",
        "savings_withdrawn",
        "goal_selected",
        "goal_reached",
        "quest_started",
        "quest_completed",
        "period_closed",
        "pet_state_changed",
        "pet_stage_changed",
        "hint_shown",
        "telemetry_consent_changed"
      ],
      "title": "EventName",
      "type": "string"
    }
  },
  "$id": "ru.mos.monetka.events.v1.EventEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Common header shared by every telemetry event.",
  "properties": {
    "android_api_level": {
      "anyOf": [
        {
          "maximum": 40,
          "minimum": 26,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Android Api Level"
    },
    "app_version": {
      "anyOf": [
        {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "App Version"
    },
    "demo_mode": {
      "default": false,
      "title": "Demo Mode",
      "type": "boolean"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_name": {
      "$ref": "#/$defs/EventName"
    },
    "ingested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingested At"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "period_no": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Period No",
      "type": "integer"
    },
    "profile_pseudo_id": {
      "format": "uuid",
      "title": "Profile Pseudo Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "event_name",
    "occurred_at",
    "profile_pseudo_id",
    "session_id",
    "period_no"
  ],
  "title": "EventEnvelope",
  "type": "object",
  "x-monetka-schema-version": 1
}
