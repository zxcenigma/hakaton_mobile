<?xml version="1.0" encoding="utf-8"?>
<!--
  Сетевая политика приложения «Монетка».

  Куда положить:
      mobile_app/android/app/src/main/res/xml/network_security_config.xml

  И сослаться в mobile_app/android/app/src/main/AndroidManifest.xml,
  в теге <application>:
      android:networkSecurityConfig="@xml/network_security_config"

  ─────────────────────────────────────────────────────────────────────────
  Зачем это нужно, если с Android 9 открытый HTTP и так запрещён.

  Запрещён по умолчанию — и ровно поэтому приложение сейчас не достучится до
  http://91.210.106.86:6767 ни на одном современном телефоне. Запрет без
  явной политики выглядит в отладчике как «сервер недоступен», и время уходит
  на проверку сервера, который работает.

  Этот файл делает правило явным: открытый HTTP выключен, и видно, что это
  решение, а не умолчание, которое кто-нибудь однажды переключит обратно
  одной строкой usesCleartextTraffic="true".

  Детские данные и JWT по открытому каналу — то, что ТЗ §3.5 запрещает
  прямо. Поэтому исключений для продакшена здесь нет вообще.
  ─────────────────────────────────────────────────────────────────────────
-->
<network-security-config>

    <!-- Везде и всегда: только TLS, только системные центры сертификации. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Послабления только для отладочной сборки.

      debug-overrides действует исключительно в debug-APK: в релиз этот блок
      не попадает физически, его нельзя забыть выключить перед публикацией.
      Именно поэтому доверие к пользовательским сертификатам (Charles, mitm-
      прокси при разборе трафика) описано здесь, а не в base-config.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
