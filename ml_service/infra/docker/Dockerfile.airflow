# Airflow image with the Monetka package installed.
#
# The DAG tasks import `monetka.*` directly rather than shelling out, so the
# package has to live in the scheduler's environment. Airflow pins a large part
# of the dependency tree, so the constraint file is used — installing without it
# resolves to versions Airflow does not support and breaks at import time.

FROM apache/airflow:2.9.3-python3.11

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential librdkafka-dev \
 && rm -rf /var/lib/apt/lists/*
USER airflow

ARG AIRFLOW_VERSION=2.9.3
ARG PYTHON_VERSION=3.11
ENV CONSTRAINT_URL="https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt"

COPY --chown=airflow:root pyproject.toml README.md /opt/monetka/
COPY --chown=airflow:root src /opt/monetka/src
COPY --chown=airflow:root content /opt/monetka/content
COPY --chown=airflow:root transform /opt/monetka/transform

RUN pip install --no-cache-dir --constraint "${CONSTRAINT_URL}" \
      "/opt/monetka[stream,transform]"

ENV MONETKA_RUN_MODE=compose \
    PYTHONPATH=/opt/monetka/src
