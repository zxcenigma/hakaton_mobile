htmlcov/

# --- data & artefacts --------------------------------------------------------
# Generated, reproducible from `monetka generate` with a fixed seed. Keeping
# them out of git is what makes the repo reviewable — and a 500 MB event dump
# in history is not something you can remove later.
# `data/*` rather than `data/`: git does not descend into an ignored
# directory, so a trailing-slash rule cannot be undone for a file inside it and
# the placeholder below would stay invisible.
data/*
artifacts/*
# The directories themselves must exist in a fresh clone — they are bind-mount
# sources, and Docker creates a missing one as root.
!data/.gitkeep
!artifacts/.gitkeep
*.duckdb
*.duckdb.wal
*.parquet
*.onnx
*.tflite
*.joblib

# --- dbt ---------------------------------------------------------------------
transform/dbt_monetka/target/
transform/dbt_monetka/dbt_packages/
transform/dbt_monetka/logs/
logs/

